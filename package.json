{
  "name": "teacher-simulator-unified",
  "version": "1.0.0",
  "description": "Педагогический симулятор - единый проект",
  "main": "server/server.js",
  "scripts": {
    "start": "java -jar new_server/working_build/eduteach-0.0.1-SNAPSHOT.jar",
    "dev:server": "java -jar new_server/working_build/eduteach-0.0.1-SNAPSHOT.jar",
    "dev:client": "cd client && npm start",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "install-all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "heroku-postbuild": "npm run build"
  },
  "keywords": ["педагогика", "симулятор", "react", "express"],
  "author": "Ваше имя",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
